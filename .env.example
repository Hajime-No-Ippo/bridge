# Token from @BotFather. Use a SEPARATE bot from the Claude Code one —
# Telegram allows only one getUpdates consumer per token (a second poller gets 409).
TELEGRAM_BOT_TOKEN=

# Token from Discord Developer Platform
DISCORD_BOT_TOKEN=

# Comma-separated chat IDs allowed to drive opencode. Send /whoami to the bot to
# learn yours. The bridge refuses to start if this is empty — it is a remote
# shell on your laptop, so it fails closed on purpose.
TELEGRAM_ALLOWED_CHAT_IDS=

# The opencode server your TUI is attached to:
#   opencode serve --port 4096
#   opencode attach http://127.0.0.1:4096
OPENCODE_URL=http://127.0.0.1:4096

# Only if you started the server with --password / OPENCODE_SERVER_PASSWORD
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# Minimum ms between Telegram edits while streaming. Telegram throttles around
# one edit per second per chat; going lower earns 429s.
EDIT_INTERVAL_MS=1200

# Only relay images whose mtime is this fresh. Without it, an agent's `ls` of
# the temp dir re-sends every old screenshot (the dedupe set resets on restart).
IMAGE_MAX_AGE_MS=300000

# At startup, delete temp screenshots older than this (1h default).
TEMP_IMAGE_TTL_MS=3600000
