# Token from @BotFather. Use a SEPARATE bot from the Claude Code one —
# Telegram allows only one getUpdates consumer per token (a second poller gets 409).
TELEGRAM_BOT_TOKEN=

# Token from Discord Developer Platform
DISCORD_BOT_TOKEN=

# Comma-separated chat IDs allowed to drive opencode. Send /whoami to the bot to
# learn yours. The bridge refuses to start if this is empty — it is a remote
# shell on your laptop, so it fails closed on purpose.
TELEGRAM_ALLOWED_CHAT_IDS=

# The opencode server your TUI is attached to:
#   opencode serve --port 4096
#   opencode attach http://127.0.0.1:4096
OPENCODE_URL=http://127.0.0.1:4096

# Only if you started the server with --password / OPENCODE_SERVER_PASSWORD
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# Minimum ms between Telegram edits while streaming. Telegram throttles around
# one edit per second per chat; going lower earns 429s.
EDIT_INTERVAL_MS=1200

# Only relay images whose mtime is this fresh. Without it, an agent's `ls` of
# the temp dir re-sends every old screenshot (the dedupe set resets on restart).
IMAGE_MAX_AGE_MS=300000

# At startup, delete temp screenshots older than this (1h default).
TEMP_IMAGE_TTL_MS=3600000

# A permission or question BLOCKS the turn until it is answered, and opencode
# never expires one on its own. After this long the bridge rejects it and
# releases the turn, so an unanswered prompt cannot wedge the session for the
# life of the process (30 min default).
PENDING_TTL_MS=1800000

# While a turn is blocked, re-post a reminder this often. The message holding
# the buttons scrolls off a phone screen within a few exchanges (5 min default).
PENDING_NUDGE_MS=300000

# Where the polling-slot pidfile lives. Telegram allows exactly one getUpdates
# consumer per token, so an orphaned bridge holds the slot and every restart
# gets 409 forever. On startup the bridge SIGTERMs a previous holder and takes
# over. Default is a token-keyed file under the temp dir; set this if your temp
# dir is not shared between runs (systemd PrivateTmp, for instance).
BRIDGE_PID_FILE=

# Force-block attachment types for models whose advertised capability is wrong.
# Comma-separated `provider/model:modality`, e.g.
#   ATTACHMENT_DENY=deepseek/deepseek-v4-pro:image
#
# The guard in src/vision.ts already refuses anything a model DECLARES it cannot
# take (deepseek-v4-pro says `input.pdf: false`, and means it). This covers the
# opposite case: a model that claims a modality and then rejects the request.
# That claim cannot be corrected from the catalogue side, and one such file
# poisons the session permanently — every later prompt re-sends the history.
ATTACHMENT_DENY=

# --- Linux migration, phase 1: browser backend (src/ubuntu24/) ---

# Which browser backend the operate_*.ts tools drive. Unset picks by platform:
# cua-driver on macOS, CDP everywhere else. Set to `cdp` on a Mac to exercise
# the Linux path against a real Chrome before an Ubuntu box exists.
BROWSER_BACKEND=

# Chrome's DevTools port and the profile it runs under. The port is
# UNAUTHENTICATED — any process running as you can attach and drive that
# browser, including reading whatever it is signed into. Chrome binds it to
# loopback, and the profile is deliberately NOT your daily one, so the exposure
# stops at accounts you signed into here on purpose. Do not point this at your
# main profile.
CHROME_CDP_PORT=9222
CHROME_PROFILE_DIR=

# Override only if Chrome/Chromium is somewhere non-standard.
CHROME_BINARY=
